{
  "name": "happymoments-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install-all": "npm install --prefix backend && npm install --prefix frontend --legacy-peer-deps",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "seed": "node backend/seeder.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
